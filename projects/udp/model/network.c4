// UDP architecture — Network.
//
// The one VPC per environment, its two isolated subnets, and the endpoints that are the only
// way out of them. Traffic runs top to bottom: the API invokes a function in an isolated
// subnet, and everything the function reaches is an endpoint beside it.

model {

  network_api = platform 'Private REST API' {
    #request-path
    description 'not in the VPC · reached by endpoint'
    link https://github.com/govuk-once/user-data-platform/blob/main/cdk/lib/constructs/api-gateway-construct.ts 'api-gateway-construct.ts'
    metadata {
      type 'AWS::ApiGateway::RestApi'
      tech 'PRIVATE endpoint type'
      role 'A regional service, not a VPC resource: a private API has no public DNS answer and accepts calls only through execute-api endpoints its policy lists.'
      facts [
        'UDP\'s own VPC also has an execute-api endpoint — that is how the end-to-end tests in CodeBuild reach the API.'
      ]
      sourceId 'api'
      order '1'
      x '188'
      y '30'
      w '292'
      h '62'
      ownership 'udp'
      awsIcon 'apigateway'
    }
  }

  network_vpc = boundary 'VPC · {env}-vpc' {
    link https://github.com/govuk-once/user-data-platform/blob/main/cdk/lib/constructs/vpc-construct.ts 'vpc-construct.ts'
    metadata {
      type 'AWS::EC2::VPC'
      tech '10.0.0.0/16 · 2 AZs · vpc-construct.ts'
      role 'One per environment, shared by every pull-request deployment in it. Two /24 subnets, both isolated, one in each of two availability zones; no internet gateway and no NAT gateway.'
      facts [
        'Can be deployed alone first: a <code>skipMainStack</code> context flag leaves every other stack out of the app.',
        'DNS support and hostnames are on, so the interface endpoints answer the services\' own names.'
      ]
      sourceId 'vpc'
      order '0'
      x '40'
      y '150'
      w '1380'
      h '470'
      boundary 'hard'
    }

    network_isolated = boundary 'private isolated · 2 subnets' {
      metadata {
        type 'Subnet tier'
        tech 'PRIVATE_ISOLATED · /24'
        role 'No route out at all. Every Lambda, and both test CodeBuild projects, run here.'
        sourceId 'isolated'
        order '0'
        x '164'
        y '200'
        w '340'
        h '264'
        boundary 'soft'
      }

      network_lambdas = platform 'Lambda functions' {
        #request-path
        description 'ENIs in both AZs'
        link https://github.com/govuk-once/user-data-platform/blob/main/cdk/lib/constructs/lambda-construct.ts 'lambda-construct.ts'
        link https://github.com/govuk-once/user-data-platform/blob/main/cdk/lib/constructs/vpc-construct.ts 'vpc-construct.ts'
        metadata {
          type 'AWS::Lambda::Function · VpcConfig'
          tech 'lambda security group'
          role 'Every function in main, sar and dvla-pilot. Their security group allows egress on 443 to the endpoint security group and DNS to the VPC resolver, and nothing else.'
          sourceId 'lambdas'
          order '1'
          x '188'
          y '250'
          w '292'
          h '62'
          ownership 'udp'
          resources [ 'subnets' ]
          awsIcon 'lambda'
        }
      }

      network_codebuild = platform 'CodeBuild · e2e and perf' {
        #off-request-path
        description 'outside production'
        link https://github.com/govuk-once/user-data-platform/blob/main/cdk/lib/constructs/codebuild-e2e-construct.ts 'codebuild-e2e-construct.ts'
        link https://github.com/govuk-once/user-data-platform/blob/main/cdk/lib/constructs/codebuild-perf-construct.ts 'codebuild-perf-construct.ts'
        link https://github.com/govuk-once/user-data-platform/blob/main/cdk/lib/constructs/vpc-construct.ts 'vpc-construct.ts'
        link https://github.com/govuk-once/user-data-platform/blob/main/cdk/buildspec-perf.yml 'buildspec-perf.yml'
        link https://github.com/govuk-once/user-data-platform/blob/main/e2e/src/helpers/cleanup.ts 'e2e/src/helpers/cleanup.ts'
        metadata {
          type 'AWS::CodeBuild::Project ×2'
          tech 'codebuild security group · endpoints and DNS only'
          role 'Calls the private API through the VPC\'s own execute-api endpoint. Its security group allows 443 to the endpoint group and DNS to the VPC resolver, and nothing else.'
          facts [
            'The performance buildspec still downloads k6 from github.com in its install phase. Nothing in these subnets routes to the internet, so that step cannot succeed as committed.',
            'The end-to-end cleanup builds its DynamoDB client with no endpoint, and the DynamoDB endpoint has no private DNS, so deleting the users a run created cannot reach the table; the helper catches the error and only logs a warning.'
          ]
          sourceId 'codebuild'
          order '2'
          x '188'
          y '380'
          w '292'
          h '62'
          ownership 'udp'
        }
      }
    }

    network_endpoints = platform 'VPC endpoints · 12' {
      #request-path
      description 'all interface endpoints'
      link https://github.com/govuk-once/user-data-platform/blob/main/cdk/lib/constructs/vpc-construct.ts 'vpc-construct.ts'
      link https://github.com/govuk-once/user-data-platform/blob/main/cdk/lib/stacks/main-stack.ts 'main-stack.ts'
      link https://github.com/govuk-once/user-data-platform/blob/main/cdk/lib/stacks/sar-stack.ts 'sar-stack.ts'
      link https://github.com/govuk-once/user-data-platform/blob/main/cdk/lib/stacks/dvla-pilot-stack.ts 'dvla-pilot-stack.ts'
      link https://github.com/govuk-once/user-data-platform/blob/main/libs/data-access/factory/ServiceFactory.ts 'ServiceFactory.ts'
      metadata {
        type 'AWS::EC2::VPCEndpoint ×12'
        tech 'endpoint security group · 443 from the VPC'
        role 'The isolated subnets\' only way out. Every one is an interface endpoint with an ENI in each subnet: KMS, SQS, Secrets Manager, CloudWatch Logs, execute-api, CodeBuild, ECR API, ECR Docker, STS, Cognito IdP, DynamoDB and S3.'
        facts [
          'The KMS endpoint is what makes envelope encryption possible from an isolated subnet.',
          'DynamoDB\'s endpoint has private DNS off, so the service\'s usual name does not reach it. The main, sar and dvla-pilot stacks give every function the endpoint\'s own DNS name as <code>DYNAMODB_ENDPOINT</code>, and the clients are pointed there.',
          'Nothing in the code calls Cognito; its endpoint is provisioned anyway.'
        ]
        sourceId 'endpoints'
        order '3'
        x '580'
        y '250'
        w '292'
        h '62'
        ownership 'udp'
        resources [ 'vpc-endpoints' ]
        awsIcon 'vpc-endpoint'
      }
    }

    network_sgs = platform 'Security groups · 3' {
      #off-request-path
      description 'lambda · endpoint · codebuild'
      link https://github.com/govuk-once/user-data-platform/blob/main/cdk/lib/constructs/vpc-construct.ts 'vpc-construct.ts'
      metadata {
        type 'AWS::EC2::SecurityGroup ×3'
        tech 'lambda and codebuild: no default outbound'
        role 'The Lambda and CodeBuild groups may each reach the endpoint group on 443 and the VPC on 53; the endpoint group admits the VPC CIDR and both groups on 443.'
        facts [
          'The Lambda group also has ingress rules — 443 from anywhere, DNS from the VPC — that nothing can use: a function ENI accepts no inbound connections.'
        ]
        sourceId 'sgs'
        order '4'
        x '1094'
        y '250'
        w '292'
        h '62'
        ownership 'udp'
        resources [ 'sgs' ]
        awsIcon 'vpc'
      }
    }

    network_nacls = platform 'Network ACL' {
      #off-request-path
      description 'deny SSH and RDP, allow the VPC'
      link https://github.com/govuk-once/user-data-platform/blob/main/cdk/lib/constructs/vpc-construct.ts 'vpc-construct.ts'
      metadata {
        type 'AWS::EC2::NetworkAcl'
        tech 'both isolated subnets'
        role 'Denies inbound 22 and 3389 from anywhere at rules 50 and 51, then allows all traffic in from, and out to, the VPC CIDR at 100. The same four entries in every environment.'
        sourceId 'nacls'
        order '5'
        x '1094'
        y '380'
        w '292'
        h '62'
        ownership 'udp'
        resources [ 'nacls', 'nacl-entries' ]
        awsIcon 'vpc'
      }
    }

    network_flowlog = platform 'VPC flow log' {
      #off-request-path
      description 'to CloudWatch Logs'
      link https://github.com/govuk-once/user-data-platform/blob/main/cdk/lib/constructs/vpc-construct.ts 'vpc-construct.ts'
      metadata {
        type 'AWS::EC2::FlowLog'
        tech 'own log group'
        role 'Every accepted and rejected flow in the VPC, kept for the environment\'s log retention.'
        sourceId 'flowlog'
        order '6'
        x '1094'
        y '510'
        w '292'
        h '62'
        ownership 'udp'
        resources [ 'flow-logs' ]
        awsIcon 'cloudwatch'
      }
    }
  }

  network_api -> network_lambdas 'invoke' {
    metadata {
      protocol 'Lambda service invocation — the API does not enter the VPC'
      auth 'The API\'s invoke permission on each function'
      carries 'The request event'
      order '1'
    }
  }
  network_lambdas -> network_endpoints 'endpoints' {
    link https://github.com/govuk-once/user-data-platform/blob/main/cdk/lib/constructs/vpc-construct.ts 'vpc-construct.ts'
    metadata {
      protocol 'HTTPS to an endpoint ENI in the same subnet; for DynamoDB, addressed by the endpoint\'s own DNS name'
      auth 'Function role; the endpoint security group admits the Lambda group on 443'
      carries 'Every table read and write, the SAR export, data keys, queue messages, the purge key, log lines'
      order '2'
    }
  }
}

views {
  view network {
    title 'Network'
    include network_api
    include network_vpc, network_vpc.**
  }
}
