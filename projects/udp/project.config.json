{
  "name": "UDP",
  "title": "UDP Architecture Explorer",
  "tagline": "User Data Platform",
  "blurb": "GOV.UK Connect’s system of record for a person: identity links to other services, the data those services hand over, and the subject access and deletion requests the law entitles a person to. Reached only by sibling systems — FLEX and UNS — each through its own VPC endpoint.",
  "repo": "https://github.com/govuk-once/user-data-platform/blob/main/",
  "inventoryView": "resources",
  "inventoryLabel": "AWS resources",
  "iconLabel": "AWS icons",
  "filterHint": "Filter — try KMS, alarm, SAR, production",
  "placementBudget": 0,
  "kinds": [
    {
      "id": "person",
      "label": "Person",
      "colour": "purple"
    },
    {
      "id": "udp",
      "label": "UDP",
      "colour": "blue"
    },
    {
      "id": "govuk",
      "label": "GOV.UK Connect",
      "colour": "teal"
    },
    {
      "id": "appside",
      "label": "GOV.UK App and Chat",
      "colour": "indigo"
    },
    {
      "id": "third",
      "label": "Outside GOV.UK Connect",
      "colour": "amber"
    }
  ],
  "stages": [
    {
      "id": "dev",
      "label": "Development",
      "facts": "development",
      "synth": "dev"
    },
    {
      "id": "stg",
      "label": "Staging",
      "facts": "staging",
      "synth": "stag"
    },
    {
      "id": "prod",
      "label": "Production",
      "facts": "production",
      "synth": "prod"
    }
  ],
  "source": {
    "repo": "git@github.com:govuk-once/user-data-platform.git",
    "ref": "main",
    "root": ".sources/udp"
  },
  "synth": {
    "cwd": "cdk",
    "command": ["npx", "tsx", "bin/app.ts"],
    "env": {
      "CDK_DEFAULT_ACCOUNT": "000000000000",
      "CDK_DEFAULT_REGION": "eu-west-2",
      "AWS_REGION": "eu-west-2",
      "DEVELOPER_ID": ""
    },
    "context": {
      "env": "{stage}"
    },
    "output": "cdk.out/{id}",
    "prepare": {
      "cwd": ".",
      "command": ["pnpm", "build:all"]
    },
    "stubs": [
      {
        "package": "@govuk-connect/tag",
        "dir": "stubs/govuk-connect-tag",
        "why": "Published only to a private CodeArtifact registry, which a public runner has no token for. The app uses it to tag what it builds, so the templates synthesised here carry none of the GovUKTag tags — Product, Owner, DataClassification, PII, Exposure — and nothing derived counts them. Read the tags in the source, not the template."
      }
    ],
    "generated": [
      {
        "file": "cdk/.generated/monitoring-inventory.json",
        "module": "taggedNames",
        "context": {
          "skipMonitoringStack": "true"
        },
        "why": "The monitoring stack alarms whatever carries Monitor=true in the deployed account: UDP's pipeline asks the Resource Groups Tagging API and writes the names here, gitignored, before it deploys that stack. The same tag is on the same resources in the app's own templates, each with the name it deploys under, so one pass without the monitoring stack (the flag UDP's local synth uses) gives the same list.",
        "tag": {
          "Monitor": "true"
        },
        "shape": {
          "lambdaNames": {
            "type": "AWS::Lambda::Function",
            "name": "FunctionName"
          },
          "tableNames": {
            "type": "AWS::DynamoDB::Table",
            "name": "TableName"
          }
        }
      }
    ]
  },
  "derive": {
    "module": "cloudformation",
    "inputs": {
      "templates": "cdk.out/{id}/*.template.json"
    },
    "counts": {
      "apiRoutes": {
        "type": "AWS::ApiGateway::Method",
        "template": "^{stage}-main$"
      },
      "functions": {
        "type": "AWS::Lambda::Function",
        "perTemplate": "^{stage}-(?<name>main|sar|dvla-pilot|vpc|macie|live-schema)$",
        "hasProperty": "FunctionName"
      },
      "functionsTotal": {
        "type": "AWS::Lambda::Function",
        "hasProperty": "FunctionName"
      },
      "tables": {
        "type": "AWS::DynamoDB::Table"
      },
      "queues": {
        "type": "AWS::SQS::Queue"
      },
      "buckets": {
        "type": "AWS::S3::Bucket"
      },
      "kmsKeys": {
        "type": "AWS::KMS::Key"
      },
      "vpcEndpoints": {
        "type": "AWS::EC2::VPCEndpoint"
      },
      "natGateways": {
        "type": "AWS::EC2::NatGateway"
      },
      "flowLogs": {
        "type": "AWS::EC2::FlowLog"
      },
      "securityGroups": {
        "type": "AWS::EC2::SecurityGroup"
      },
      "networkAcls": {
        "type": "AWS::EC2::NetworkAcl"
      },
      "networkAclEntries": {
        "type": "AWS::EC2::NetworkAclEntry"
      },
      "subnets": {
        "type": "AWS::EC2::Subnet"
      },
      "webAcls": {
        "type": "AWS::WAFv2::WebACL"
      },
      "logGroups": {
        "type": "AWS::Logs::LogGroup"
      },
      "iamRoles": {
        "type": "AWS::IAM::Role"
      },
      "snsTopics": {
        "type": "AWS::SNS::Topic"
      },
      "dashboards": {
        "type": "AWS::CloudWatch::Dashboard"
      },
      "apiKeys": {
        "type": "AWS::ApiGateway::ApiKey"
      },
      "usagePlans": {
        "type": "AWS::ApiGateway::UsagePlan"
      },
      "backupPlans": {
        "type": "AWS::Backup::BackupPlan"
      },
      "backupSelections": {
        "type": "AWS::Backup::BackupSelection"
      },
      "backupVaults": {
        "type": "AWS::Backup::BackupVault"
      },
      "codeBuildProjects": {
        "type": "AWS::CodeBuild::Project"
      },
      "appConfigApplications": {
        "type": "AWS::AppConfig::Application"
      },
      "e2eStacks": {
        "type": "AWS::IAM::Role",
        "template": "-e2e$",
        "templatesContaining": true
      },
      "macieStacks": {
        "type": "AWS::KMS::Key",
        "template": "-macie$",
        "templatesContaining": true
      },
      "alarmsTotal": {
        "type": "AWS::CloudWatch::Alarm"
      },
      "alarmsLambdaErrors": {
        "type": "AWS::CloudWatch::Alarm",
        "logicalId": "Lambda(Dev|Stag|Prod)Errors[0-9A-F]+$"
      },
      "alarmsLambdaDuration": {
        "type": "AWS::CloudWatch::Alarm",
        "logicalId": "Lambda(Dev|Stag|Prod)Duration[0-9A-F]+$"
      },
      "alarmsLambdaThrottles": {
        "type": "AWS::CloudWatch::Alarm",
        "logicalId": "Lambda(Dev|Stag|Prod)Throttles[0-9A-F]+$"
      },
      "alarmsDynamo": {
        "type": "AWS::CloudWatch::Alarm",
        "logicalId": "Dynamo(ReadThrottled|SystemErrors|WriteThrottled)[0-9A-F]+$"
      },
      "alarmsApi": {
        "type": "AWS::CloudWatch::Alarm",
        "logicalId": "^ApiGateway"
      },
      "dsqlClusters": {
        "type": "AWS::DSQL::Cluster"
      },
      "eventSourceMappings": {
        "type": "AWS::Lambda::EventSourceMapping"
      }
    }
  }
}
