{
  "name": "UDP",
  "title": "UDP Architecture Explorer",
  "tagline": "User Data Platform",
  "blurb": "GOV.UK Once’s system of record for a person: identity links to other services, the data those services hand over, and the subject access and deletion requests the law entitles a person to. Reached only by sibling systems — FLEX and UNS — each through its own VPC endpoint.",
  "repo": "https://github.com/govuk-once/user-data-platform/blob/main/",
  "inventoryView": "resources",
  "inventoryLabel": "AWS resources",
  "iconLabel": "AWS icons",
  "filterHint": "Filter — try KMS, alarm, SAR, production",
  "placementBudget": 1,
  "kinds": [
    {
      "id": "person",
      "label": "Person",
      "colour": "purple"
    },
    {
      "id": "udp",
      "label": "UDP",
      "colour": "blue"
    },
    {
      "id": "govuk",
      "label": "GOV.UK Once",
      "colour": "teal"
    },
    {
      "id": "third",
      "label": "Outside GOV.UK Once",
      "colour": "amber"
    }
  ],
  "stages": [
    {
      "id": "dev",
      "label": "Development",
      "facts": "development",
      "synth": "dev"
    },
    {
      "id": "stg",
      "label": "Staging",
      "facts": "staging",
      "synth": "stag"
    },
    {
      "id": "prod",
      "label": "Production",
      "facts": "production",
      "synth": "prod"
    }
  ],
  "source": {
    "repo": "git@github.com:govuk-once/user-data-platform.git",
    "ref": "main",
    "root": ".sources/udp"
  },
  "synth": {
    "cwd": "cdk",
    "command": ["npx", "tsx", "bin/app.ts"],
    "env": {
      "CDK_DEFAULT_ACCOUNT": "000000000000",
      "CDK_DEFAULT_REGION": "eu-west-2",
      "AWS_REGION": "eu-west-2",
      "DEVELOPER_ID": ""
    },
    "context": {
      "env": "{stage}"
    },
    "output": "cdk.out/{id}",
    "prepare": {
      "cwd": ".",
      "command": ["pnpm", "build:all"]
    }
  },
  "derive": {
    "module": "cloudformation",
    "inputs": {
      "templates": "cdk.out/{id}/*.template.json"
    },
    "counts": {
      "apiRoutes": {
        "type": "AWS::ApiGateway::Method",
        "template": "^{stage}-main$"
      },
      "functions": {
        "type": "AWS::Lambda::Function",
        "perTemplate": "^{stage}-(?<name>main|sar|dvla-pilot|vpc|macie)$",
        "hasProperty": "FunctionName"
      },
      "functionsTotal": {
        "type": "AWS::Lambda::Function",
        "hasProperty": "FunctionName"
      },
      "tables": {
        "type": "AWS::DynamoDB::Table"
      },
      "queues": {
        "type": "AWS::SQS::Queue"
      },
      "buckets": {
        "type": "AWS::S3::Bucket"
      },
      "kmsKeys": {
        "type": "AWS::KMS::Key"
      },
      "vpcEndpoints": {
        "type": "AWS::EC2::VPCEndpoint"
      },
      "natGateways": {
        "type": "AWS::EC2::NatGateway"
      },
      "flowLogs": {
        "type": "AWS::EC2::FlowLog"
      },
      "securityGroups": {
        "type": "AWS::EC2::SecurityGroup"
      },
      "networkAcls": {
        "type": "AWS::EC2::NetworkAcl"
      },
      "networkAclEntries": {
        "type": "AWS::EC2::NetworkAclEntry"
      },
      "subnets": {
        "type": "AWS::EC2::Subnet"
      },
      "webAcls": {
        "type": "AWS::WAFv2::WebACL"
      },
      "logGroups": {
        "type": "AWS::Logs::LogGroup"
      },
      "iamRoles": {
        "type": "AWS::IAM::Role"
      },
      "snsTopics": {
        "type": "AWS::SNS::Topic"
      },
      "dashboards": {
        "type": "AWS::CloudWatch::Dashboard"
      },
      "apiKeys": {
        "type": "AWS::ApiGateway::ApiKey"
      },
      "usagePlans": {
        "type": "AWS::ApiGateway::UsagePlan"
      },
      "backupPlans": {
        "type": "AWS::Backup::BackupPlan"
      },
      "backupSelections": {
        "type": "AWS::Backup::BackupSelection"
      },
      "backupVaults": {
        "type": "AWS::Backup::BackupVault"
      },
      "codeBuildProjects": {
        "type": "AWS::CodeBuild::Project"
      },
      "appConfigApplications": {
        "type": "AWS::AppConfig::Application"
      },
      "e2eStacks": {
        "type": "AWS::IAM::Role",
        "template": "-e2e$",
        "templatesContaining": true
      },
      "macieStacks": {
        "type": "AWS::KMS::Key",
        "template": "-macie$",
        "templatesContaining": true
      },
      "alarmsTotal": {
        "type": "AWS::CloudWatch::Alarm"
      },
      "alarmsLambdaErrors": {
        "type": "AWS::CloudWatch::Alarm",
        "logicalId": "^Lambda\\d+Errors"
      },
      "alarmsLambdaDuration": {
        "type": "AWS::CloudWatch::Alarm",
        "logicalId": "^Lambda\\d+Duration"
      },
      "alarmsLambdaThrottles": {
        "type": "AWS::CloudWatch::Alarm",
        "logicalId": "^Lambda\\d+Throttles"
      },
      "alarmsDynamo": {
        "type": "AWS::CloudWatch::Alarm",
        "logicalId": "^DynamoDb"
      },
      "alarmsApi": {
        "type": "AWS::CloudWatch::Alarm",
        "logicalId": "^ApiGateway"
      }
    }
  }
}
