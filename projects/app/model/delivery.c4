      metadata {
        type 'GitHub Actions workflow'
        tech 'nx affected'
        role 'Builds, validates, tests and scans. Deploys nothing.'
        facts [
          'Runs on every push, not on pull requests, so its pull-request Sonar branch is never taken.',
