        role 'Every merge to main becomes an APK for testers.'
        facts [
          'The <code>alpha</code> build type takes the <code>.dev</code> application id and staging values, and signs with an alpha keystore decoded from Bitwarden.'
        ]
        sourceId 'androidalpha'
        order '10'
        x '278'
        y '640'
        w '200'
