    delivery_androidrelease = internal 'release.yml' {
      #off-request-path
      description 'push to release/*'
      link https://github.com/govuk-once/govuk-mobile-android-app/blob/main/.github/workflows/release.yml 'android · release.yml'
      link https://github.com/govuk-once/govuk-mobile-android-app/blob/main/fastlane/Fastfile 'android · Fastfile'
      link https://github.com/govuk-once/govuk-mobile-android-app/blob/main/app/build.gradle.kts 'android · app/build.gradle.kts'
      metadata {
        type 'GitHub Actions workflow'
        tech 'fastlane android deploy'
        role 'A release bundle, signed and uploaded to Google Play.'
        facts [
          'The release keystore and the Google service account come from Bitwarden.',
          'A release build signs with the release key only when <code>RELEASE_KEYSTORE</code> is set, and falls back to the debug key when it is not.'
        ]
        sourceId 'androidrelease'
        order '11'
        x '492'
        y '640'
        w '200'
        h '62'
