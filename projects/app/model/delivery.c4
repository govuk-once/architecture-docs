      metadata {
        type 'Git repository'
        tech 'GitHub'
        role 'Three triggers: a pull request, a push to main, a push to a release branch.'
        facts [
          'Pull requests may target <code>main</code>, <code>release/*</code> or <code>feature/*</code>.'
        ]
        sourceId 'androidrepo'
        order '8'
        x '278'
        y '510'
        w '200'
        h '62'
        ownership 'app'
