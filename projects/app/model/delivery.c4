      link https://github.com/alphagov/govuk-mobile-backend/blob/main/.github/workflows/auth-post-merge.yaml 'backend · auth-post-merge.yaml'
      link https://github.com/alphagov/govuk-mobile-backend/blob/main/.github/workflows/chat-post-merge.yaml 'backend · chat-post-merge.yaml'
      metadata {
        type 'GitHub Actions workflow'
        tech 'OIDC to AWS · devplatform-upload-action'
        role 'Validates, builds and uploads each stack, per environment.'
        facts [
          'Assumes a role in AWS through GitHub OIDC, builds with SAM, and uploads the build to an artifact bucket with a code-signing profile. The upload action, not this repository, turns that into a deployment.',
          'Also builds a test image per stack and pushes it to ECR, signed with a KMS key.'
