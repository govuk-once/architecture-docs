      link https://github.com/govuk-once/govuk-mobile-android-app/blob/main/.github/workflows/pull_request.yml 'android · pull_request.yml'
      metadata {
        type 'GitHub Actions workflow'
        tech 'one job'
        role 'Gates a pull request.'
