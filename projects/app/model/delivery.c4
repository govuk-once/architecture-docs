// GOV.UK App architecture — Delivery.
//
// Four repositories, each in its own zone: what runs on a pull request, what ships a
// release, and where it lands. The last step each repository takes is here; anything
// after it happens somewhere these repositories do not show. Alerting is in the last zone,
// because that is where production reaches a person. Nothing here is on the request path.

model {

  delivery_ioszone = boundary 'govuk-mobile-ios-app · govuk-once' {
    metadata {
      type 'Repository'
      tech 'Xcode · Swift Package Manager · fastlane'
      role 'The iOS app, and everything that builds and ships it.'
      facts [
        'Moved from <code>alphagov</code>, where the old repository is archived and points here.'
      ]
      sourceId 'ioszone'
      order '0'
      x '40'
      y '30'
      w '676'
      h '400'
      boundary 'soft'
    }

    delivery_iosrepo = internal 'iOS source' {
      #off-request-path
      description 'main · release/** · PRs'
      link https://github.com/govuk-once/govuk-mobile-ios-app/blob/main/README.md 'ios · README.md'
      link https://github.com/govuk-once/govuk-mobile-ios-app/blob/main/.github/workflows/pull_request.yml 'ios · pull_request.yml'
      metadata {
        type 'Git repository'
        tech 'GitHub'
        role 'Three triggers: a pull request, a push to main, a push to a release branch.'
        facts [
          'Pull requests may target <code>develop</code>, <code>release/*</code>, <code>feature/*</code> or <code>main</code>.'
        ]
        sourceId 'iosrepo'
        order '1'
        x '278'
        y '80'
        w '200'
        h '62'
        ownership 'app'
      }
    }

    delivery_iospr = internal 'PR checks' {
      #off-request-path
      description 'pull_request.yml'
      link https://github.com/govuk-once/govuk-mobile-ios-app/blob/main/.github/workflows/pull_request.yml 'ios · pull_request.yml'
      metadata {
        type 'GitHub Actions workflow'
        tech 'three reusable workflows'
        role 'Gates a pull request.'
        facts [
          'Calls <code>lint.yml</code>, <code>unit_test.yml</code> and <code>sonar_scan_pr.yml</code>.'
        ]
        sourceId 'iospr'
        order '2'
        x '64'
        y '210'
        w '200'
        h '62'
        ownership 'app'
      }
    }

    delivery_iosalpha = internal 'alpha.yml' {
      #off-request-path
      description 'push to main · by hand'
      link https://github.com/govuk-once/govuk-mobile-ios-app/blob/main/.github/workflows/alpha.yml 'ios · alpha.yml'
      link https://github.com/govuk-once/govuk-mobile-ios-app/blob/main/Fastlane/Fastfile 'ios · Fastfile'
      metadata {
        type 'GitHub Actions workflow'
        tech 'macos-15 · fastlane alpha'
        role 'Every merge to main becomes an ad-hoc build for testers.'
        facts [
          'Lint, unit tests and Sonar first, then <code>fastlane alpha</code> in the Staging environment by default, or Integration when chosen by hand.',
          'The backend URLs are GitHub environment variables set at this step — the repository holds only the staging values.'
        ]
        sourceId 'iosalpha'
        order '3'
        x '278'
        y '210'
        w '200'
        h '62'
        ownership 'app'
      }
    }

    delivery_iosbeta = internal 'beta.yml' {
      #off-request-path
      description 'release/** · Fridays 15:00'
      link https://github.com/govuk-once/govuk-mobile-ios-app/blob/main/.github/workflows/beta.yml 'ios · beta.yml'
      link https://github.com/govuk-once/govuk-mobile-ios-app/blob/main/.github/workflows/schedule.yml 'ios · schedule.yml'
      link https://github.com/govuk-once/govuk-mobile-ios-app/blob/main/Fastlane/Matchfile 'ios · Matchfile'
      metadata {
        type 'GitHub Actions workflow'
        tech 'macos-15 · fastlane beta · Production environment'
        role 'A release build, signed for the App Store and sent to TestFlight.'
        facts [
          'Runs on a push to <code>release/**</code>, and every Friday at 15:00 through <code>schedule.yml</code>, whose branch check does not gate it.',
          'Certificates come from <code>govuk-once/govuk-mobile-ios-certificates</code> through fastlane match; the match password, the App Store Connect key and the Firebase account come from Bitwarden.'
        ]
        sourceId 'iosbeta'
        order '4'
        x '492'
        y '210'
        w '200'
        h '62'
        ownership 'app'
      }
    }

    delivery_ioschecks = internal 'SwiftLint · unit · Sonar' {
      #off-request-path
      description 'lint.yml · unit_test.yml'
      link https://github.com/govuk-once/govuk-mobile-ios-app/blob/main/.github/workflows/lint.yml 'ios · lint.yml'
      link https://github.com/govuk-once/govuk-mobile-ios-app/blob/main/.github/workflows/unit_test.yml 'ios · unit_test.yml'
      metadata {
        type 'Reusable workflows'
        tech 'swiftlint --strict · fastlane unit · SonarQube'
        role 'What a pull request has to pass.'
        facts [
          'The unit lane runs <code>scan</code> and converts coverage with <code>slather</code> for Sonar.'
        ]
        sourceId 'ioschecks'
        order '5'
        x '64'
        y '340'
        w '200'
        h '62'
        ownership 'app'
      }
    }

    delivery_iosfad = external 'Firebase App Distribution' {
      #off-request-path
      description 'ios-alpha-testers'
      link https://github.com/govuk-once/govuk-mobile-ios-app/blob/main/Fastlane/Fastfile 'ios · Fastfile'
      metadata {
        type 'Third party · Google'
        tech 'firebase_app_distribution'
        role 'Where every merge to main goes.'
        facts [
          'The build number is the latest Firebase build plus one.'
        ]
        sourceId 'iosfad'
        order '6'
        x '278'
        y '340'
        w '200'
        h '62'
        ownership 'vendor'
      }
    }

    delivery_testflight = external 'TestFlight' {
      #off-request-path
      description 'external group GOV.UK APP'
      link https://github.com/govuk-once/govuk-mobile-ios-app/blob/main/Fastlane/Fastfile 'ios · Fastfile'
      metadata {
        type 'Third party · Apple'
        tech 'fastlane pilot · App Store Connect API key'
        role 'Where a release build goes. The repository stops here.'
        facts [
          'No lane submits to the App Store: there is no <code>deliver</code> and no <code>upload_to_app_store</code>.'
        ]
        sourceId 'testflight'
        order '7'
        x '492'
        y '340'
        w '200'
        h '62'
        ownership 'vendor'
      }
    }
  }

  delivery_androidzone = boundary 'govuk-mobile-android-app · govuk-once' {
    metadata {
