      #off-request-path
      description 'KMS · ECDSA_SHA_256'
      link https://github.com/alphagov/govuk-mobile-backend-config/blob/main/tools/create-signature.sh 'config · create-signature.sh'
      link https://github.com/alphagov/govuk-mobile-backend-config/blob/main/tools/minify-json.sh 'config · minify-json.sh'
      metadata {
        type 'AWS::KMS::Key · outside these repositories'
        tech 'alias/config-signing-key'
        role 'Signs a SHA-256 digest of every minified file.'
        facts [
          'Nothing here creates the key; the workflow only calls <code>kms sign</code> with its alias.'
        ]
        sourceId 'signingkey'
        order '23'
        x '770'
        y '900'
        w '200'
        h '62'
        ownership 'app'
      }
    }

    delivery_buckets = internal 'Config buckets' {
      #off-request-path
      description 'integration · production'
      link https://github.com/alphagov/govuk-mobile-backend-config/blob/main/tools/deploy-signed-json.sh 'config · deploy-signed-json.sh'
      metadata {
        type 'S3 · outside these repositories'
        tech 'govuk-app-remote-config-{integration,production}'
        role 'What the app reads config from, through the CDN.'
        facts [
          'Each object is uploaded as <code>application/json</code> with its signature in the metadata <code>govuk-sig</code>; a file removed from the repository is removed from the bucket.'
        ]
        sourceId 'buckets'
        order '24'
        x '984'
        y '900'
        w '200'
        h '62'
        ownership 'app'
      }
    }

    delivery_fastly = external 'Fastly' {
      #off-request-path
      description 'purged after each deploy'
      link https://github.com/alphagov/govuk-mobile-backend-config/blob/main/.github/workflows/fastly-purge-production.yaml 'config · fastly-purge-production.yaml'
      link https://github.com/alphagov/govuk-mobile-backend-config/blob/main/.github/workflows/fastly-purge-integration.yaml 'config · fastly-purge-integration.yaml'
      metadata {
        type 'Third party'
        tech 'Fastly API · token from Bitwarden'
        role 'Caches the config; every deploy empties it.'
        facts [
          'One service per environment. That these services front the buckets is inferred from the app\'s URLs, not stated here.'
        ]
        sourceId 'fastly'
        order '25'
        x '984'
        y '1030'
        w '200'
        h '62'
        ownership 'vendor'
      }
    }
  }

  delivery_operate = boundary 'Operate · both stacks' {
    metadata {
      type 'Alerting'
      tech 'CloudWatch · SNS · AWS Chatbot'
      role 'How the deployed backend reaches a person when it goes wrong.'
      facts [
        'The chat stack creates no topic; its alarms name the auth stack\'s by name.'
      ]
      sourceId 'operate'
      order '0'
      x '1452'
      y '30'
      w '248'
      h '530'
      boundary 'soft'
    }

    delivery_canary = internal 'Smoke test' {
      #off-request-path
      description 'weekdays, every 5 minutes'
      link https://github.com/alphagov/govuk-mobile-backend/blob/main/services/auth/smoke-test/app.ts 'backend · smoke-test/app.ts'
      link https://github.com/alphagov/govuk-mobile-backend/blob/main/services/auth/template.yaml 'backend · services/auth/template.yaml'
      metadata {
        type 'AWS::Serverless::Function'
        tech 'cron · Europe/London, 9 to 5'
        role 'Signs a test user in through the proxy and reports success as a metric.'
        facts [
          'Emits <code>GOVUKMobileAuth/SmokeTestSuccess</code>, shown on the one dashboard the templates create.',
          'Development and production mint a real App Check token for it; staging runs without.'
        ]
        sourceId 'canary'
        order '26'
        x '1476'
        y '80'
        w '200'
        h '62'
        ownership 'app'
        resources [ 'dashboards' ]
      }
    }

    delivery_alarms = internal 'CloudWatch alarms' {
      #off-request-path
      description '38 auth · 5 chat'
      link https://github.com/alphagov/govuk-mobile-backend/blob/main/services/auth/template.yaml 'backend · services/auth/template.yaml'
      link https://github.com/alphagov/govuk-mobile-backend/blob/main/services/chat/template.yaml 'backend · services/chat/template.yaml'
      metadata {
        type 'AWS::CloudWatch::Alarm'
        tech 'Every alarm is in the table below'
        role 'Cognito throttles, API errors and latency, Lambda concurrency, throttles and timeouts, WAF blocks, the health check and the smoke test.'
        facts [
          'Two have their actions disabled: the smoke test, and the attestation 200-proportion anomaly.',
          'Several watch metrics nothing publishes as they expect — the timeout filters emit no dimensions, the 4xx filters emit none the alarms name, and the completion alarm\'s metric has no filter at all.'
        ]
        sourceId 'alarms'
        order '27'
        x '1476'
        y '210'
        w '200'
        h '62'
        ownership 'app'
        resources [ 'alarms', 'metric-filters' ]
      }
    }

    delivery_topics = internal 'Alarm topics' {
      #off-request-path
      description 'paging · warnings'
      link https://github.com/alphagov/govuk-mobile-backend/blob/main/services/auth/template.yaml 'backend · services/auth/template.yaml'
      metadata {
        type 'AWS::SNS::Topic × 2'
        tech 'KMS-encrypted'
        role 'Every alarm publishes to one of these, and only CloudWatch alarms may.'
        facts [
          'The paging topic calls PagerDuty over HTTPS in production, at a URL from SSM, and a stand-in Lambda that only logs everywhere else.',
          'The warnings topic has no subscriber of its own; Chatbot is its only reader.'
        ]
        sourceId 'topics'
        order '28'
        x '1476'
        y '340'
        w '200'
        h '62'
        ownership 'app'
        resources [ 'sns-topics' ]
      }
    }

    delivery_oncall = external 'PagerDuty · Slack' {
      #off-request-path
      description 'on call · out of hours'
      link https://github.com/alphagov/govuk-mobile-backend/blob/main/services/auth/template.yaml 'backend · services/auth/template.yaml'
      metadata {
        type 'Third parties'
        tech 'HTTPS subscription · AWS Chatbot'
        role 'Where an alarm reaches a person.'
        facts [
          'Both topics feed one Slack channel through Chatbot; the channel and workspace IDs and the PagerDuty URL are all SSM parameters.'
        ]
        sourceId 'oncall'
        order '29'
        x '1476'
        y '470'
        w '200'
        h '62'
        ownership 'vendor'
        resources [ 'chatbot' ]
      }
    }
  }

  delivery_iosrepo -> delivery_iospr 'on pull_request' { metadata { protocol 'GitHub Actions' auth '—' carries 'The branch' order '1' } }
  delivery_iosrepo -> delivery_iosalpha 'on push to main' { metadata { protocol 'GitHub Actions' auth '—' carries 'main' order '2' } }
  delivery_iosrepo -> delivery_iosbeta 'on push to release/**' { metadata { protocol 'GitHub Actions' auth '—' carries 'A release branch' order '3' } }
  delivery_iospr -> delivery_ioschecks 'calls' { metadata { protocol 'workflow_call' auth '—' carries 'Three workflows' order '4' } }
  delivery_iosalpha -> delivery_iosfad 'ad-hoc build' { metadata { protocol 'fastlane' auth 'Firebase service account' carries 'uk.gov.govuk.dev, -DSTAGING' order '5' } }
  delivery_iosbeta -> delivery_testflight 'app-store build' { metadata { protocol 'fastlane pilot' auth 'App Store Connect API key' carries 'uk.gov.govuk, -DPRODUCTION' order '6' } }
  delivery_androidrepo -> delivery_androidpr 'on pull_request' { metadata { protocol 'GitHub Actions' auth '—' carries 'The branch' order '7' } }
  delivery_androidrepo -> delivery_androidalpha 'on push to main' { metadata { protocol 'GitHub Actions' auth '—' carries 'main' order '8' } }
  delivery_androidrepo -> delivery_androidrelease 'on push to release/*' { metadata { protocol 'GitHub Actions' auth '—' carries 'A release branch' order '9' } }
  delivery_androidpr -> delivery_androidchecks 'runs' { metadata { protocol 'Gradle' auth '—' carries 'lint, Kover, sonar' order '10' } }
  delivery_androidalpha -> delivery_androidfad 'APK' { metadata { protocol 'Gradle App Distribution plugin' auth 'Firebase service account' carries 'The alpha build' order '11' } }
  delivery_androidrelease -> delivery_play 'bundle, draft' { metadata { protocol 'fastlane supply' auth 'Google service account' carries 'The release bundle' order '12' } }
  delivery_backendrepo -> delivery_backendci 'on every push' { metadata { protocol 'GitHub Actions' auth '—' carries 'Any branch' order '13' } }
  delivery_backendrepo -> delivery_backendpublish 'on push to main · production' { metadata { protocol 'GitHub Actions' auth '—' carries 'main or production' order '14' } }
  delivery_backendci -> delivery_backendscans 'runs' { metadata { protocol 'nx affected' auth '—' carries 'Build, validate, lint, test, scan' order '15' } }
  delivery_backendpublish -> delivery_testimage 'builds, pushes' { metadata { protocol 'devplatform-upload-action-ecr' auth 'OIDC-assumed role · container signing key' carries 'The test image, tagged latest' order '25' } }
  delivery_backendpublish -> delivery_devbuild 'uploads' { metadata { protocol 'OIDC-assumed role · devplatform-upload-action' auth 'GitHub OIDC' carries 'Both stacks, signed' order '16' } }
  delivery_configrepo -> delivery_configvalidate 'on every push' { metadata { protocol 'GitHub Actions' auth '—' carries 'Any branch' order '17' } }
  delivery_configrepo -> delivery_configdeploy 'on push to main · by hand' { metadata { protocol 'GitHub Actions' auth '—' carries 'main' order '18' } }
  delivery_configdeploy -> delivery_signingkey 'kms sign' { metadata { protocol 'AWS KMS' auth 'OIDC-assumed role' carries 'A SHA-256 digest per file' edgeStyle 'dash' order '19' } }
  delivery_configdeploy -> delivery_buckets 's3 sync --delete' { metadata { protocol 'AWS S3' auth 'OIDC-assumed role' carries 'Every signed file' order '20' } }
  delivery_buckets -> delivery_fastly 'served through · purged' { metadata { protocol 'HTTPS POST purge_all' auth 'Fastly API token' carries 'A purge, after every deploy' order '21' } }
  delivery_canary -> delivery_alarms 'SmokeTestSuccess' { metadata { protocol 'CloudWatch metric' auth 'IAM role' carries '1 or 0, every five minutes' order '22' } }
  delivery_alarms -> delivery_topics 'ALARM · OK' { metadata { protocol 'SNS publish' auth 'Topic policy: CloudWatch alarms only' carries 'State changes' order '23' } }
  delivery_topics -> delivery_oncall 'notifies' { metadata { protocol 'HTTPS · Chatbot' auth 'SSM-held URL and channel' carries 'Alarm and OK notifications' order '24' } }
}

views {
  view delivery {
    title 'Delivery'
    include delivery_ioszone, delivery_ioszone.**
    include delivery_androidzone, delivery_androidzone.**
    include delivery_backendzone, delivery_backendzone.**
    include delivery_configzone, delivery_configzone.**
    include delivery_operate, delivery_operate.**
  }
}
