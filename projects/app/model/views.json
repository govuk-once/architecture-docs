  "signin": {
    "name": "Sign-in path",
    "order": 2,
    "group": "Architecture",
    "audience": "On-call, and anyone tracing a sign-in",
    "blurb": "Every hop a sign-in takes, numbered in reading order, and what each one checks. The authorize leg runs in a browser and never touches the proxy; the token leg runs from the app to the proxy, which adds the one secret the app never holds.",
    "note": "Hops 2 and 3 are a browser redirect round trip, drawn both ways. Hops 7a and 7b are what the access token is for; either can come first.",
    "dashMeans": "a supporting fetch, not the sign-in itself",
    "tables": [
      {
        "name": "What the app keeps, where, and for how long",
        "code": [
          ["template.yaml", "backend:services/auth/template.yaml"],
          ["0.0.85.toml", "config:versions/appinfo/0.0.85.toml"],
          [
            "Container+Configs.swift",
            "ios:Production/govuk_ios/Extensions/Container/Container+Configs.swift"
          ],
          [
            "Constants.swift",
            "ios:Production/govuk_ios/Extensions/GovKit/Constants.swift"
          ],
          [
            "AuthModule.kt",
            "android:data/src/main/kotlin/uk/gov/govuk/data/auth/di/AuthModule.kt"
          ],
          [
            "TimeoutManager.kt",
            "android:app/src/main/kotlin/uk/gov/govuk/TimeoutManager.kt"
          ]
        ],
        "cols": ["Item", "Where", "Lifetime"],
        "rows": [
          ["Access token", "Memory", "5 minutes, set on the app client"],
          ["ID token", "Memory", "1 hour"],
          [
            "Refresh token",
            "Secure store: current biometrics on iOS; biometrics or passcode on Android",
            "365 days at Cognito. The app stops using it once <code>refreshTokenExpirySeconds</code> from the signed config has passed since the ID token was issued: 31,532,400 by default, 604,800 in integration"
          ],
          [
            "Session",
            "Memory",
            "Ends after 15 minutes without interaction, with a warning at 13; the refresh token survives it"
          ]
        ]
      }
    ],
    "w": 1200,
    "h": 740
  },
  "linking": {
    "name": "Account linking",
    "order": 3,
    "group": "Architecture",
