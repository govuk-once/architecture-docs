  security_egressfns = platform 'Egress-tier functions' {
    #request-path
    description 'authorizer · DVLA gateway'
    technology 'FlexPrivateEgressFunction · SG allow all outbound'
    link https://github.com/govuk-once/flex/blob/main/platform/infra/flex/src/stacks/domain.ts 'stacks/domain.ts'
    metadata {
      type 'AWS::Lambda::Function'
      tech 'FlexPrivateEgressFunction · SG allow all outbound'
      role 'The functions allowed to reach the internet.'
      facts [
        'Security group <code>PrivateEgress</code> is created with allow-all outbound, so nothing constrains egress but the NAT route and the NACL — see Network.'
      ]
      sourceId 'egressfns'
      order '21'
      x '500'
      y '790'
      w '280'
      h '62'
      ownership 'flex'
      awsIcon 'lambda'
      resources [
        'lambda-domain-dvla',
        'subnets-egress',
        'lambda-gw-dvla'
      ]
    }
  }

  security_isofns = platform 'Isolated-tier functions' {
    #request-path
    description 'every other domain and gateway'
    technology 'FlexPrivateIsolatedFunction · SG deny outbound'
    link https://github.com/govuk-once/flex/blob/main/platform/infra/flex/src/stacks/domain.ts 'stacks/domain.ts'
    link https://github.com/govuk-once/flex/blob/main/platform/infra/flex/src/stacks/core/vpc.ts 'stacks/core/vpc.ts'
    metadata {
      type 'AWS::Lambda::Function'
      tech 'FlexPrivateIsolatedFunction · SG deny outbound'
      role 'The functions with no route out.'
      facts [
        'Security group <code>PrivateIsolated</code> allows outbound only on 443 to each endpoint\'s security group — six rules, one per endpoint, and nothing else. Its NACL allows outbound only to the VPC CIDR.'
      ]
      sourceId 'isofns'
      order '22'
      x '880'
      y '790'
      w '330'
      h '62'
      ownership 'flex'
      awsIcon 'lambda'
      resources [
        'lambda-domain-udp',
        'lambda-domain-uns',
        'subnets-isolated',
        'lambda-gw-udp',
        'lambda-gw-uns'
      ]
    }
  }

  security_nat = platform 'NAT gateways × 3' {
    #request-path
    description 'one per AZ · 3 Elastic IPs'
    technology 'Default route for the egress tier'
    link https://github.com/govuk-once/flex/blob/main/platform/infra/flex/src/stacks/core/vpc.ts 'stacks/core/vpc.ts'
    metadata {
      type 'AWS::EC2::NatGateway'
      tech 'Default route for the egress tier'
      role 'The only path from the VPC to the internet.'
      facts [
        'The three Elastic IPs are the source addresses a third party such as DVLA sees.'
      ]
      sourceId 'nat'
      order '23'
      x '500'
      y '980'
      w '280'
      h '62'
      ownership 'flex'
      awsIcon 'vpc-nat'
      resources [
        'nat'
      ]
    }
  }

  security_vpce = platform 'Interface endpoints × 6' {
    #request-path
    description 'execute-api · logs · secrets · ssm · sts · kms'
    technology 'ENIs in the egress subnets'
    link https://github.com/govuk-once/flex/blob/main/platform/infra/flex/src/stacks/core/endpoints.ts 'stacks/core/endpoints.ts'
    metadata {
      type 'AWS::EC2::VPCEndpoint'
      tech 'ENIs in the egress subnets'
      role 'What the isolated tier can reach.'
      facts [
        'Each endpoint\'s security group is open to the VPC CIDR on 443; the KMS one adds an explicit rule per isolated subnet. No cognito-idp or X-Ray endpoint exists, so the JWKS fetch goes over NAT.',
        'The execute-api endpoint\'s id is what the private API\'s resource policy pins.'
      ]
      sourceId 'vpce'
      order '24'
      x '860'
      y '980'
      w '360'
      h '62'
      ownership 'flex'
      awsIcon 'vpc-endpoint'
      resources [
        'vpce',
        'sg-endpoints'
      ]
    }
  }

  security_flow = platform 'VPC flow logs → S3' {
    #off-request-path
    description 'ALL traffic · KMS · object lock 365d'
    technology 'Extended fields · KMS-encrypted bucket'
    link https://github.com/govuk-once/flex/blob/main/platform/infra/flex/src/stacks/core/vpc.ts 'stacks/core/vpc.ts'
    metadata {
      type 'AWS::EC2::FlowLog'
      tech 'Extended fields · KMS-encrypted bucket'
      role 'Every accepted and rejected flow in the VPC.'
      facts [
        'The bucket is object-locked at 365 days GOVERNANCE. No reader grant sits on top of the account-root key policy, so decrypt is delegated to IAM — see Network.'
      ]
      sourceId 'flow'
      order '25'
      x '860'
      y '1070'
      w '280'
      h '62'
      ownership 'flex'
      awsIcon 'vpc-flowlogs'
      resources [
        'flowlog',
        's3-flowlogs',
        'kms-flowlog'
      ]
    }
  }

  security_boundary = platform 'IAM permissions boundary' {
    #off-request-path
    description 'one policy per stack'
    technology 'Applied by PermissionsBoundary.of(stack)'
    link https://github.com/govuk-once/flex/blob/main/platform/infra/flex/src/utils/createPermissionsBoundary.ts 'createPermissionsBoundary.ts'
    metadata {
      type 'AWS::IAM::ManagedPolicy'
      tech 'Applied by PermissionsBoundary.of(stack)'
      role 'A hard ceiling on every Flex role.'
      facts [
        '<b>DenyDirectLambdaInvoke</b> — Deny <code>lambda:InvokeFunction</code> on <code>*</code>. No FLEX function can invoke another directly. This single statement is the reason the private API design exists.',
        '<b>AllowFlexPrivateApiInvoke</b> — <code>execute-api:Invoke</code> scoped to <code>arnForExecuteApi("*", "/*", "*")</code> on the private API alone, so no role can reach a different API even if its inline policy grants it.',
        'Four baseline Allows on <code>*</code>: logs (3 actions), X-Ray (2), the five ENI actions, and service integrations — Secrets Manager read and describe, six SSM parameter actions including <code>PutParameter</code> and <code>DeleteParameter</code>, <code>kms:Decrypt</code> and <code>sts:AssumeRole</code>. CKV_AWS_107/108/111 are suppressed with recorded reasons.',
        'One policy in the platform stack and one per deployed domain stack. Roles created in the core, global, deploy and smoke-test stacks are <b>not</b> under a boundary.',
        'Applied to every role Flex constructs create. The roles CDK generates for its own providers, the relay functions, the API Gateway CloudWatch role and the smoke-test role sit outside it — 11 of 35 in production, counted on Resources.'
      ]
      sourceId 'boundary'
      order '26'
      x '90'
      y '500'
      w '282'
      h '62'
      ownership 'flex'
      awsIcon 'iam'
      resources [
        'iam-boundary',
        'iam-roles'
      ]
    }
  }

  security_secrets = platform 'Secrets Manager × 2' {
    #off-request-path
    description 'origin-verify · WAF e2e bypass'
    technology 'One per stack that needs it'
    link https://github.com/govuk-once/flex/blob/main/platform/infra/flex/src/stacks/platform.ts 'stacks/platform.ts'
    link https://github.com/govuk-once/flex/blob/main/platform/infra/flex/src/stacks/global.ts 'stacks/global.ts'
    link https://github.com/govuk-once/flex/blob/main/platform/shared/src/createConsumerConfigLoader.ts 'shared/createConsumerConfigLoader.ts'
    metadata {
      type 'AWS::SecretsManager::Secret'
      tech 'One per stack that needs it'
      role 'The two secrets that are themselves controls.'
      facts [
        '<code>/{stage}/flex-secret/origin-verify-secret</code> is created in eu-west-2 and replicated to us-east-1; <code>/{stage}/flex-secret/waf/e2e-bypass</code> the other way round. Both use AWS managed keys with a recorded CKV_AWS_149 suppression so replication stays simple.',
        'Both are resolved by CloudFormation at <b>deploy</b> time into the WAF byte-match strings and the CloudFront custom header, so rotating either one takes a redeploy of both stacks, not just a new secret version.',
        'The three consumer-config secrets are imported, not created: each gateway reads its own at runtime through <code>getSecret</code> with a 600-second cache and Zod-parses it. DVLA\'s holds the API key, username and password — they are used only inside the gateway Lambda.'
      ]
      sourceId 'secrets'
      order '27'
      x '90'
      y '800'
      w '282'
      h '62'
      ownership 'flex'
      awsIcon 'secretsmanager'
      resources [
        'secrets'
      ]
    }
  }

  security_kms = platform 'KMS keys × 3' {
    #off-request-path
    description 'flow logs · alarm topics · relay'
    technology 'Customer-managed'
    link https://github.com/govuk-once/flex/blob/main/platform/infra/flex/src/utils/lambda.ts 'utils/lambda.ts'
    link https://github.com/govuk-once/flex/blob/main/platform/infra/flex/src/constructs/lambda/flex-public-function.ts 'flex-public-function.ts'
    link https://github.com/govuk-once/flex/blob/main/platform/infra/flex/src/stacks/core/vpc.ts 'core/vpc.ts'
    metadata {
      type 'AWS::KMS::Key'
      tech 'Customer-managed'
      role 'What is encrypted with a key FLEX owns.'
      facts [
        'Created: <code>alias/flex-vpc-flow-logs-key</code> and <code>alias/flex-alerts-key</code> in eu-west-2, <code>alias/{stage}-flex-alerts-relay-key</code> in us-east-1.',
        'The fourth is imported, not created: /{env}/flex-param/secret/encryption-key encrypts the environment variables of every function built on the Flex* constructs, each of which is then granted decrypt on it.',
        '<b>Defect:</b> that key is read with <code>StringParameter.valueForStringParameter</code> rather than <code>BaseStack.import()</code>, so it records no stack-dependency edge and gets no synth-time existence check — a missing parameter fails at deploy instead of at synth, unlike every other imported value.',
        'The flow-log key grants only the write path to <code>delivery.logs.amazonaws.com</code>. No reader grant is written on top of CDK\'s default account-root <code>kms:*</code> statement, so decrypt is delegated to IAM rather than blocked outright.'
      ]
      sourceId 'kms'
      order '28'
      x '90'
      y '900'
      w '282'
      h '62'
      ownership 'flex'
      awsIcon 'kms'
      resources [
        'kms-flowlog',
        'kms-alerts',
        'kms-relay',
        'kms-lambda-env'
      ]
    }
  }

