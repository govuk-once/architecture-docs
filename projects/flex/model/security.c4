// FLEX architecture — Security.
//
// Every control, drawn where it acts, with the counts gated against the synthesised
// templates and every claim cited. The zones read outside in: 1 the edge, the ingress row,
// the VPC, and the identity column that bounds every box on every path.

model {

  security_z_edge = boundary '1 · Edge · us-east-1 · FlexGlobal' {
    metadata {
      type 'Region · global stack'
      tech '—'
      role 'Everything a request meets before it reaches London: DNS, certificate, CloudFront, the CloudFront Web ACL, Shield, and the viewer-request function.'
      facts [
        'The only stack outside eu-west-2. Its alarms reach the London topics through a cross-region relay whose inline handler has a syntax error, so every us-east-1 alarm currently reaches nobody — see Delivery.'
      ]
      sourceId 'z-edge'
      order '1'
      x '440'
      y '130'
      w '1200'
      h '220'
      boundary 'hard'
      resources [
        's3-cflogs',
        'kms-relay'
      ]
    }
  }

  security_z_region = boundary '2 · eu-west-2 · London · the FLEX account' {
    metadata {
      type 'Region · account boundary'
      tech '—'
      role 'Every FLEX stack but the global one.'
      sourceId 'z-region'
      order '2'
      x '30'
      y '400'
      w '1610'
      h '920'
      boundary 'hard'
    }
  }

  security_z_ingress = boundary 'Ingress and callers · FlexPlatform · FlexSmokeTest' {
    metadata {
      type 'Stack'
      tech '—'
      role 'The two REST APIs and the controls in front of them.'
      sourceId 'z-ingress'
      order '3'
      x '440'
      y '440'
      w '1170'
      h '220'
      boundary 'hard'
      resources [
        'api-public',
        'api-private'
      ]
    }
  }

  security_z_vpc = boundary 'VPC 10.0.0.0/16 · eu-west-2a/b/c · FlexCore' {
    metadata {
      type 'Network boundary'
      tech '—'
      role 'Three tiers of three subnets; the two Lambda tiers differ only in what their security group and route table allow out.'
      facts [
        'Ephemeral PR stages create none of this — they import the development VPC, which is why every VPC count reads 0 for them.'
      ]
      sourceId 'z-vpc'
      order '4'
      x '440'
      y '690'
      w '1170'
      h '490'
      boundary 'hard'
      resources [
        'vpc',
        'subnets-public',
        'subnets-egress',
        'subnets-isolated',
        'nacl-public',
        'nacl-egress',
        'nacl-isolated',
        'flowlog',
        's3-flowlogs',
        'kms-flowlog'
      ]
    }
  }

  security_z_egress = boundary 'Private with egress · /19 × 3' {
    metadata {
      type 'Subnet tier'
      tech '—'
      role 'Functions that must reach the public internet: the authorizer\'s JWKS fetch, and the DVLA gateway.'
      sourceId 'z-egress'
      order '5'
      x '470'
      y '740'
      w '340'
      h '140'
      boundary 'hard'
      resources [
        'sg-egress'
      ]
    }
  }

  security_z_isolated = boundary 'Private isolated · /19 × 3' {
    metadata {
      type 'Subnet tier'
      tech '—'
      role 'Every other domain and gateway function. No route out; only the six endpoints are reachable.'
      sourceId 'z-isolated'
      order '6'
      x '850'
      y '740'
      w '730'
      h '140'
      boundary 'hard'
      resources [
        'sg-isolated'
      ]
    }
  }

  security_z_public = boundary 'Public · /24 × 3' {
    metadata {
      type 'Subnet tier'
      tech '—'
      role 'Nothing runs here. It exists to hold the NAT gateways and the route to the internet gateway.'
      sourceId 'z-public'
      order '7'
      x '470'
      y '930'
      w '340'
      h '220'
      boundary 'hard'
      resources [
        'nat',
        'igw'
      ]
    }
  }

  security_z_identity = boundary '3 · Identity, secrets, keys and roles' {
    metadata {
      type 'Cross-cutting controls'
      tech '—'
      role 'The controls that are not a box on any path but bound every box on every path.'
      sourceId 'z-identity'
      order '8'
      x '60'
      y '440'
      w '340'
      h '840'
      boundary 'hard'
      resources [
        'ssm-written',
        'ssm-imported'
      ]
    }
  }

  security_z_outside = boundary 'Outside · GOV.UK Once' {
    metadata {
      type 'Ownership boundary'
      tech '—'
      role 'Every party FLEX talks to, and who owns it.'
      sourceId 'z-outside'
      order '9'
      x '1680'
      y '130'
      w '340'
      h '1090'
      boundary 'hard'
    }
  }

  security_z_third = boundary 'Outside · third parties' {
    metadata {
      type 'Ownership boundary'
      tech '—'
      role 'The one party FLEX calls that is not GOV.UK Once, and the network it is reached over.'
      facts [
        'Only the egress tier can reach here, and only through the NAT gateways — the isolated tier has no route out at all.'
      ]
      sourceId 'z-third'
      order '99'
      x '440'
      y '1360'
      w '1200'
      h '170'
      boundary 'hard'
    }
  }

  security_routescope = platform 'Per-route ARN scoping' {
    #off-request-path
    description 'one inline statement per method'
    technology 'integrations[] → PolicyStatement per HTTP method'
    link https://github.com/govuk-once/flex/blob/main/platform/infra/flex/src/utils/integrations.ts 'utils/integrations.ts'
    link https://github.com/govuk-once/flex/blob/main/libs/sdk/src/route/validate-integrations.ts 'sdk/route/validate-integrations.ts'
    metadata {
      type 'AWS::IAM::Policy (inline)'
      tech 'integrations[] → PolicyStatement per HTTP method'
      role 'Turns each route\\\'s declared integrations into least-privilege IAM.'
      facts [
        'A route function\'s inline policy lists only the route ARNs that route\'s own <code>integrations</code> array names, grouped by method, with SIDs <code>AllowApiAccess{Domain}{Method}</code>.',
        'Domain integrations resolve to <code>/domains/{target}/{version}{path}</code> and gateway ones to <code>/gateways/{target}/{version}{path}</code>. The stage segment is left as <code>*</code>.',
        '<b>Gap:</b> <code>validateDomainIntegrations</code> filters to <code>type: "domain"</code>, so only 6 of the 36 declared integrations are validated. The 30 gateway integrations are never checked against a real gateway route — which is how local-council\'s two calls to <code>/v1/local-council/*</code> on the udp gateway reach CI intact and 404 at runtime.'
      ]
      sourceId 'routescope'
      order '60'
      x '90'
      y '600'
      w '282'
      h '62'
      ownership 'flex'
      awsIcon 'iam'
      resources [
        'api-routes-private',
        'api-routes-gateways'
      ]
    }
  }
  security_dlambda = platform 'Route execution roles' {
    #request-path
    description 'one generated role per function'
    technology 'NodejsFunction execution role under the boundary'
    link https://github.com/govuk-once/flex/blob/main/platform/infra/flex/src/stacks/domain.ts 'stacks/domain.ts'
    link https://github.com/govuk-once/flex/blob/main/libs/sdk/src/route/build-context.ts 'sdk/route/build-context.ts'
    link https://github.com/govuk-once/flex/blob/main/platform/infra/flex/src/utils/create-service-gateway.ts 'utils/create-service-gateway.ts'
    metadata {
      type 'AWS::IAM::Role (generated per function)'
      tech 'NodejsFunction execution role under the boundary'
      role 'The identity every internal call is made with.'
      facts [
        'Every route function gets its own generated role. The only hand-written roles in the app are the API Gateway CloudWatch role and <code>{env}-flex-smoke-test-role</code>, the one role with an explicit physical name.',
        'Calls to the private API are SigV4-signed with the function\'s own execution-role credentials. Only the UDP and UNS gateways swap in assumed-role credentials, granted per gateway as <code>sts:AssumeRole</code> on one named role ARN and cached for the STS hour.',
        '<code>ctx.auth.pairwiseId</code> exists on public routes only; a private route has no <code>ctx.auth</code> at all and takes identity as a declared header if it needs one.'
      ]
      sourceId 'dlambda'
      order '60'
      x '90'
      y '700'
      w '282'
      h '62'
      ownership 'flex'
      awsIcon 'iam'
      resources [
        'iam-roles',
        'lambda-domain-dvla',
        'lambda-gw-dvla',
        'lambda-gw-udp',
        'lambda-gw-uns'
      ]
    }
  }
  security_s3tls = platform 'S3 TLS enforcement' {
    #off-request-path
    description 'a CDK Aspect on every bucket'
    technology 'EnforceS3Https implements IAspect'
    link https://github.com/govuk-once/flex/blob/main/platform/infra/flex/src/aspects/enforce-s3-https.ts 'aspects/enforce-s3-https.ts'
    metadata {
      type 'AWS::S3::BucketPolicy'
      tech 'EnforceS3Https implements IAspect'
      role 'Denies non-TLS requests on every bucket in the app.'
      facts [
        'Adds a Deny on <code>s3:*</code> for AnyPrincipal when <code>aws:SecureTransport</code> is false, covering both the bucket ARN and its objects.',
        'Applied to the <code>App</code>, so a new bucket cannot be added without it — though it matches on <code>instanceof Bucket</code>, so an imported or L1 bucket would not be visited.'
      ]
      sourceId 's3tls'
      order '60'
      x '90'
      y '1000'
      w '282'
      h '62'
      ownership 'flex'
      awsIcon 's3'
      resources [
        's3-tls',
        's3-specs',
        's3-cflogs',
        's3-speclogs',
        's3-flowlogs'
      ]
    }
  }
  security_redact = platform 'Log redaction' {
    #off-request-path
    description 'a JSON replacer on every line'
    technology '@flex/logging sanitizer'
    link https://github.com/govuk-once/flex/blob/main/libs/logging/src/sanitizer.ts 'logging/sanitizer.ts'
    link https://github.com/govuk-once/flex/blob/main/libs/logging/src/logger.ts 'logging/logger.ts'
    metadata {
      type 'Powertools jsonReplacerFn'
      tech '@flex/logging sanitizer'
      role 'Last line of defence between a handler and CloudWatch.'
      facts [
        '20 secret key patterns (token, authorization, card and CVV forms) and 17 PII key patterns (names, DOB, NINO, postcode, sort code) match on key names. Values are matched against a JWT prefix, email, UK phone, NINO, postcode and IPv4 patterns, plus a Luhn-checked card-number detector.',
        '<code>FLEX_LOG_PII_DEBUG</code> can switch off the PII half — but never in production, where the check returns false unconditionally. <code>FlexLogger.setLogLevel</code> is a hard no-op in production for the same reason.',
        '<code>addSecretValue</code>, <code>addSensitiveKey</code> and <code>addSensitivePattern</code> exist for runtime registration, with longest-first escaped alternation — but nothing in the repository calls them.'
      ]
      sourceId 'redact'
      order '60'
      x '90'
      y '1100'
      w '282'
      h '62'
      ownership 'flex'
      awsIcon 'cloudwatch'
      resources [
        'loggroups',
        'macie'
      ]
    }
  }
  security_app = internal 'GOV.UK App' {
    #request-path
    description 'mobile client'
    technology 'Mobile client'
    link https://github.com/govuk-once/flex/blob/main/platform/smoke-test/src/handler.ts 'smoke-test handler.ts'
    metadata {
      type 'GOV.UK Once system'
      tech 'Mobile client'
      role 'The only external production caller.'
      facts [
        'Calls /app/{domain}/{version}/… over HTTPS with a Cognito access token as a Bearer — see Context.'
      ]
      sourceId 'app'
      order '10'
      x '700'
      y '20'
      w '262'
      h '62'
      ownership 'govuk'
    }
  }

  security_dns = platform 'Route 53 + ACM' {
    #request-path
    description 'DNS · certificate'
    technology 'DNS-validated · TLS'
    link https://github.com/govuk-once/flex/blob/main/platform/infra/flex/src/stacks/global.ts 'stacks/global.ts'
    metadata {
      type 'AWS::CertificateManager::Certificate'
      tech 'DNS-validated · TLS'
      role 'The hostname and the certificate the distribution presents.'
      facts [
        'The certificate is DNS-validated and its ARN crosses regions through an SSM parameter read by the global stack.'
      ]
      sourceId 'dns'
      order '11'
      x '470'
      y '180'
      w '200'
      h '62'
      ownership 'flex'
      awsIcon 'route53'
      resources [
        'acm-cert'
      ]
    }
  }

  security_cfdist = platform 'CloudFront distribution' {
    #request-path
    description 'TLSv1.2_2021 · HTTPS only'
    technology 'Viewer TLS floor TLSv1.2_2021'
    link https://github.com/govuk-once/flex/blob/main/platform/infra/flex/src/stacks/global.ts 'stacks/global.ts'
    link https://github.com/govuk-once/flex/blob/main/platform/infra/flex/src/constructs/cloudfront/flex-response-headers-policy.ts 'flex-response-headers-policy.ts'
    metadata {
      type 'AWS::CloudFront::Distribution'
      tech 'Viewer TLS floor TLSv1.2_2021'
      role 'The single public front door for the API and the docs.'
      facts [
        'Viewer TLS floor is <code>SecurityPolicyProtocol.TLS_V1_2_2021</code>. The API behaviour is <code>HTTPS_ONLY</code>; /docs* is <code>REDIRECT_TO_HTTPS</code>.',
        'Response headers on both behaviours: HSTS 365 days with includeSubdomains, <code>X-Frame-Options: DENY</code>, nosniff, <code>Referrer-Policy: no-referrer</code> and <code>X-Permitted-Cross-Domain-Policies: none</code>. The API behaviour adds <code>default-src \'self\'</code> and <code>Cache-Control: no-store</code>.',
        'It adds the <code>x-origin-verify</code> custom header to every request it forwards to the API origin — that header is the entire origin lock.'
      ]
      sourceId 'cfdist'
      order '12'
      x '700'
      y '180'
      w '262'
      h '62'
      ownership 'flex'
      awsIcon 'cloudfront'
      resources [
        'cf-dist',
        'cf-rhp',
        'acm-cert'
      ]
    }
  }

  security_wafcf = platform 'CloudFront Web ACL' {
    #request-path
    description '5 rules · default allow'
    technology 'Scope CLOUDFRONT'
    link https://github.com/govuk-once/flex/blob/main/platform/infra/flex/src/stacks/global.ts 'stacks/global.ts'
    metadata {
      type 'AWS::WAFv2::WebACL'
      tech 'Scope CLOUDFRONT'
      role 'First filter on every viewer request.'
      facts [
        'Priority order: <b>0</b> AWSManagedRulesCommonRuleSet · <b>1</b> AWSManagedRulesKnownBadInputsRuleSet · <b>2</b> AWSManagedRulesSQLiRuleSet · <b>3</b> BypassForE2ETests (allow) · <b>4</b> AWSManagedRulesAmazonIpReputationList · <b>5</b> RateLimit, block above 2000 per IP.',
        'Rule 2 is an exact byte match on the <code>x-flex-e2e-bypass</code> header against a generated secret. Because it is an <b>allow</b> it terminates evaluation and skips rules 3 and 4 — but 0 and 1 have already run.',
        'Data protection substitutes the <code>authorization</code> header in WAF logs, sampled requests and rate-based details.',
        'No <code>LoggingConfiguration</code> is created for either Web ACL — see the detective-controls table below.'
      ]
      sourceId 'wafcf'
      order '13'
      x '900'
      y '270'
      w '222'
      h '62'
      ownership 'flex'
      awsIcon 'waf'
      resources [
        'waf-cf',
        'alarms-waf'
      ]
    }
  }

  security_shield = platform 'Shield Advanced' {
    #request-path
    description 'staging and production only'
    technology 'Automatic response: count'
    link https://github.com/govuk-once/flex/blob/main/platform/infra/flex/src/stacks/global.ts 'stacks/global.ts'
    metadata {
      type 'AWS::Shield::Protection'
      tech 'Automatic response: count'
      role 'DDoS protection on the distribution.'
      facts [
        '<code>#createCloudfrontShield</code> early-exits when the environment is development, so the development environment and every ephemeral and personal stage have no protection and no DDoS alarms.',
        'Application-layer automatic response is ENABLED with action <b>count</b> — attacks are evaluated and reported, not mitigated automatically.',
        'Not created in development or any ephemeral stage — the count reads 0 there and that is correct, not a gap in the model.'
      ]
      sourceId 'shield'
      order '14'
      x '1240'
      y '270'
      w '236'
      h '62'
      ownership 'flex'
      awsIcon 'shield'
      resources [
        'shield',
        'alarms-shield'
      ]
    }
  }

  security_cff = platform 'Viewer-request function' {
    #request-path
    description 'JWT shape check at the edge'
    technology 'CloudFront Functions runtime'
    link https://github.com/govuk-once/flex/blob/main/platform/domains/viewer-request-cff-platform/src/handler.ts 'cff-platform handler.ts'
    link https://github.com/govuk-once/flex/blob/main/platform/domains/viewer-request-cff-platform/src/validators/jwt.ts 'validators/jwt.ts'
    metadata {
      type 'AWS::CloudFront::Function'
      tech 'CloudFront Functions runtime'
      role 'Rejects requests with no plausible Bearer token before they leave the edge.'
      facts [
        'Fails on: missing Authorization header, no <code>Bearer</code> prefix, extra header segments, wrong JWT segment count, header or body that is not JSON, and <code>alg: none</code>. The signature is only checked for presence — never verified.',
        'A rejection is a 401 carrying <code>x-rejected-by: cloudfront-function</code>; success emits <code>cff_token_validated</code>.',
        'It also sets <code>x-correlation-id</code>, keeping the inbound value only if it is a v4 UUID. The /docs* behaviour runs a different function that only rewrites URIs.'
      ]
      sourceId 'cff'
      order '15'
      x '1240'
      y '180'
      w '242'
      h '62'
      ownership 'flex'
      awsIcon 'cloudfront-functions'
      resources [
        'alarms-cff',
        'cff-platform'
      ]
    }
  }

  security_wafreg = platform 'REGIONAL Web ACL' {
    #request-path
    description '2 rules · default BLOCK'
    technology 'Scope REGIONAL · on the API stage'
    link https://github.com/govuk-once/flex/blob/main/platform/infra/flex/src/stacks/platform.ts 'stacks/platform.ts'
    metadata {
      type 'AWS::WAFv2::WebACL'
      tech 'Scope REGIONAL · on the API stage'
      role 'The origin lock.'
      facts [
        'The default action is <b>block</b>, which is what makes the raw <code>execute-api</code> URL unusable: rule 2 is the only thing that lets a request through.',
        'Rule 0 is KnownBadInputs and rule 1 the SQLi ruleset; rule 2 RequireOriginSecret is an <code>EXACTLY</code> byte match on the <code>x-origin-verify</code> single header with no text transformation.',
        '<code>sampledRequestsEnabled</code> is false on the origin-secret rule, so the header value is never captured into sampled requests.'
      ]
      sourceId 'wafreg'
      order '16'
      x '470'
      y '480'
      w '232'
      h '62'
      ownership 'flex'
      awsIcon 'waf'
      resources [
        'waf-regional'
      ]
    }
  }

  security_pubapi = platform 'Public REST API' {
    #request-path
    description 'REGIONAL · TLS 1.3/1.2'
    technology 'securityPolicy TLS13_1_2_2021_06'
    link https://github.com/govuk-once/flex/blob/main/platform/infra/flex/src/stacks/platform.ts 'stacks/platform.ts'
    metadata {
      type 'AWS::ApiGateway::RestApi'
      tech 'securityPolicy TLS13_1_2_2021_06'
      role 'Every /app route, behind the authorizer.'
      facts [
        '<code>securityPolicy: SecurityPolicy_TLS13_1_2_2021_06</code>, set on the L1 resource rather than through the L2 props.',
        'Two gateway responses are overridden: <b>401</b> UNAUTHORIZED and <b>403</b> ACCESS_DENIED, both returning the same constant JSON body <code>{"message": "Unauthorized", "type": "auth_error"}</code>.',
        'Each domain stack attaches its own <code>TokenAuthorizer</code> over the shared authorizer function, and only if that domain has public routes.',
        'Access logs and execution logs at ERROR level, X-Ray tracing on, no data trace.'
      ]
      sourceId 'pubapi'
      order '17'
      x '732'
      y '480'
      w '222'
      h '62'
      ownership 'flex'
      awsIcon 'apigateway'
      resources [
        'api-public',
        'alarms-apigw',
        'api-stage-public',
        'api-authorizer',
        'api-routes-public'
      ]
    }
  }

  security_authfn = platform 'Cognito token authorizer' {
    #request-path
    description 'egress tier · JWKS over NAT'
    technology 'FlexPrivateEgressFunction'
    link https://github.com/govuk-once/flex/blob/main/platform/domains/auth/src/handler.ts 'auth handler.ts'
    link https://github.com/govuk-once/flex/blob/main/platform/domains/auth/src/services/auth-service.ts 'auth/services/auth-service.ts'
    link https://github.com/govuk-once/flex/blob/main/platform/domains/auth/src/createPolicy.ts 'auth/createPolicy.ts'
    metadata {
      type 'AWS::Lambda::Function'
      tech 'FlexPrivateEgressFunction'
      role 'Verifies the Cognito access token in front of every public route.'
      facts [
        'Verifies issuer <code>https://cognito-idp.{region}.amazonaws.com/{USERPOOL_ID}</code>, <code>token_use: access</code> and the client id. <code>audience</code> is deliberately null, because Cognito access tokens carry none.',
        'The <b>only</b> thing it asserts downstream is <code>pairwiseId</code>, taken from the token\'s <code>username</code> claim and returned in the authorizer context. <code>principalId</code> is the constant string <code>anonymous</code>.',
        'Deny is scoped to <code>event.methodArn</code>. Since FLEX-365 no denial carries a message — an expired token and a forged one are indistinguishable to the caller, and the difference is kept in telemetry instead. The 401 fires only when API Gateway rejects before the authorizer runs.',
        '<b>Gap:</b> the allow policy is returned with <code>Resource: "*"</code> instead of the invoked method ARN, so a single successful verification authorizes every method on the API.',
        'The verifier is constructed inside the handler, so the three environment variables are Zod-parsed on every invocation.'
      ]
      sourceId 'authfn'
      order '18'
      x '984'
      y '480'
      w '262'
      h '62'
      ownership 'flex'
      awsIcon 'lambda'
      resources [
        'api-authorizer',
        'lambda-auth',
        'lambda-jwks'
      ]
    }
  }

  security_privapi = platform 'Private REST API' {
    #request-path
    description 'PRIVATE · IAM on every method'
    technology 'EndpointConfiguration PRIVATE'
    link https://github.com/govuk-once/flex/blob/main/platform/infra/flex/src/stacks/platform.ts 'stacks/platform.ts'
    metadata {
      type 'AWS::ApiGateway::RestApi'
      tech 'EndpointConfiguration PRIVATE'
      role 'The only way one FLEX function reaches another.'
      facts [
        'The resource policy holds a single statement: <b>Deny</b> <code>execute-api:Invoke</code> for AnyPrincipal whenever <code>aws:SourceVpce</code> is not that one endpoint.',
        'There is <b>no explicit Allow</b>, so for same-account callers the caller\'s own IAM policy is the sole gate — which is exactly what the boundary and the per-route policy below are for.',
        '<code>AuthorizationType.IAM</code> is the default method option, so every method requires a signed request, <code>/health</code> included.',
        'Execution logs at INFO on this stage, ERROR on the public one.'
      ]
      sourceId 'privapi'
      order '19'
      x '1276'
      y '480'
      w '262'
      h '62'
      ownership 'flex'
      awsIcon 'apigateway'
      resources [
        'api-private',
        'api-stage-private',
        'api-routes-private',
        'api-routes-gateways'
      ]
    }
  }

  security_jwks = platform 'Stub JWKS Function URL' {
    #request-path
    description 'development only'
    technology 'Unauthenticated Function URL'
    link https://github.com/govuk-once/flex/blob/main/platform/infra/flex/src/stacks/platform.ts 'stacks/platform.ts'
    metadata {
      type 'AWS::Lambda::Function'
      tech 'Unauthenticated Function URL'
      role 'The signing keys the authorizer trusts in development.'
      facts [
        'Created only in development, with no VPC. Its unauthenticated URL is the authorizer\'s <code>JWKS_URI</code> there, reached over NAT like any public host — see Network.'
      ]
      sourceId 'jwks'
      order '20'
      x '984'
      y '580'
      w '176'
      h '62'
      ownership 'flex'
      awsIcon 'lambda'
      resources [
        'lambda-jwks'
      ]
