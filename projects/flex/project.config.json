{
  "name": "FLEX",
  "title": "FLEX Architecture Explorer",
  "tagline": "Federated Logic and Events eXchange",
  "blurb": "The GOV.UK App’s API layer: one public API for the app, one private API for everything internal, and the service gateways that broker every call out to a sibling system or a third party.",
  "repo": "https://github.com/govuk-once/flex/blob/main/",
  "inventoryView": "resources",
  "inventoryLabel": "AWS resources",
  "iconLabel": "AWS icons",
  "filterHint": "Filter — try isolated, KMS, 365 days, alarm",
  "softBudget": 7,
  "placementBudget": 74,
  "kinds": [
    {
      "id": "person",
      "label": "Person",
      "colour": "purple"
    },
    {
      "id": "flex",
      "label": "FLEX",
      "colour": "blue"
    },
    {
      "id": "govuk",
      "label": "GOV.UK Once",
      "colour": "teal"
    },
    {
      "id": "third",
      "label": "Outside GOV.UK Once",
      "colour": "amber"
    }
  ],
  "stages": [
    {
      "id": "dev",
      "label": "Development",
      "facts": "development",
      "synth": "development"
    },
    {
      "id": "stg",
      "label": "Staging",
      "facts": "staging",
      "synth": "staging"
    },
    {
      "id": "prod",
      "label": "Production",
      "facts": "production",
      "synth": "production"
    },
    {
      "id": "eph",
      "label": "Ephemeral PR",
      "facts": "ephemeral",
      "synth": "pr-0"
    }
  ],
  "source": {
    "repo": "git@github.com:govuk-once/flex.git",
    "ref": "main",
    "root": ".sources/flex"
  },
  "derive": {
    "module": "cloudformation",
    "inputs": {
      "templates": "cdk.out/{id}/*.template.json"
    },
    "counts": {
      "domainFunctions": {
        "type": "AWS::Lambda::Function",
        "perTemplate": "^{stage}-(?<name>(?!Flex)[a-z-]+)$"
      },
      "publicRoutes": {
        "type": "AWS::ApiGateway::Method",
        "template": "^{stage}-(?!Flex)",
        "logicalId": "^PublicRoot"
      },
      "privateRoutes": {
        "type": "AWS::ApiGateway::Method",
        "template": "^{stage}-(?!Flex)",
        "logicalId": "^PrivateRoot"
      },
      "domainsWithAuthorizer": {
        "type": "AWS::ApiGateway::Authorizer",
        "template": "^{stage}-(?!Flex)",
        "templatesContaining": true
      },
      "alarms": {
        "type": "AWS::CloudWatch::Alarm",
        "distinctBy": "construct",
        "scopeAliases": {
          "^(Private)?GatewayAlarms$": "API Gateway",
          "^Alarms$": "CloudFront",
          "^CffAlarms": "CloudFront Function",
          "^ShieldAlarms$": "Shield",
          "Waf": "WAF",
          "FlexSmokeTest$": "Smoke test",
          "Alarm$": "Lambda"
        },
        "capture": [
          "Threshold",
          "EvaluationPeriods",
          "DatapointsToAlarm",
          "ComparisonOperator",
          "TreatMissingData",
          "MetricName",
          "Statistic",
          "ExtendedStatistic",
          "AlarmActions"
        ]
      },
      "securityGroups": {
        "type": "AWS::EC2::SecurityGroup"
      },
      "vpcEndpoints": {
        "type": "AWS::EC2::VPCEndpoint"
      },
      "natGateways": {
        "type": "AWS::EC2::NatGateway"
      },
      "flowLogs": {
        "type": "AWS::EC2::FlowLog"
      },
      "webAcls": {
        "type": "AWS::WAFv2::WebACL"
      },
      "shieldProtections": {
        "type": "AWS::Shield::Protection"
      },
      "kmsKeys": {
        "type": "AWS::KMS::Key"
      },
      "secrets": {
        "type": "AWS::SecretsManager::Secret"
      },
      "certificates": {
        "type": "AWS::CertificateManager::Certificate"
      },
      "iamRoles": {
        "type": "AWS::IAM::Role"
      },
      "iamRolesBounded": {
        "type": "AWS::IAM::Role",
        "hasProperty": "PermissionsBoundary"
      },
      "logGroups": {
        "type": "AWS::Logs::LogGroup"
      },
      "authorizers": {
        "type": "AWS::ApiGateway::Authorizer"
      },
      "wafCloudFront": {
        "type": "AWS::WAFv2::WebACL",
        "logicalId": "^CfWebAcl"
      },
      "wafRegional": {
        "type": "AWS::WAFv2::WebACL",
        "logicalId": "^ApiWebAcl"
      },
      "sgEgress": {
        "type": "AWS::EC2::SecurityGroup",
        "logicalId": "^PrivateEgress"
      },
      "sgIsolated": {
        "type": "AWS::EC2::SecurityGroup",
        "logicalId": "^PrivateIsolated"
      },
      "sgEndpoints": {
        "type": "AWS::EC2::SecurityGroup",
        "logicalId": "^Vpc.*SecurityGroup"
      },
      "kmsFlowLog": {
        "type": "AWS::KMS::Key",
        "logicalId": "^FlowLogKey"
      },
      "kmsAlerts": {
        "type": "AWS::KMS::Key",
        "logicalId": "^AlarmTopicKey"
      },
      "kmsRelay": {
        "type": "AWS::KMS::Key",
        "logicalId": "^AlarmTopicRelayKey"
      },
      "boundaryPolicies": {
        "type": "AWS::IAM::ManagedPolicy"
      },
      "macieStacks": {
        "type": "AWS::IAM::Role",
        "template": "FlexMacie",
        "templatesContaining": true
      }
    }
  },
  "synth": {
    "cwd": "platform/infra/flex",
    "command": ["pnpm", "exec", "tsx", "src/app.ts"],
    "env": {
      "STAGE": "{stage}",
      "CDK_DEFAULT_ACCOUNT": "000000000000",
      "CDK_DEFAULT_REGION": "eu-west-2",
      "AWS_REGION": "eu-west-2"
    },
    "output": "cdk.out/{id}"
  }
}
