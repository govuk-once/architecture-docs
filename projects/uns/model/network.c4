// UNS architecture — Network.
//
// One VPC per main environment, two tiers, and which functions are in it. Most are not:
// the HTTP handlers run outside the VPC and reach DynamoDB and SQS over the public
// service endpoints; only the pipeline functions and the cache are inside.

model {

  network_apis = platform 'REST APIs · PSO public, FLEX private' {
    #request-path
    description 'not in the VPC'
    link https://github.com/govuk-once/gds-unified-notification-service/blob/main/infrastructure/cdk/constructs/bases/UNSApiGatewayConstruct.ts 'UNSApiGatewayConstruct.ts'
    metadata {
      type 'AWS::ApiGateway::RestApi ×2 · ×3 in development'
      tech 'REGIONAL with a custom domain · PRIVATE through FLEX\'s endpoints'
      role 'Regional services. The private one is bound to this VPC\'s own execute-api endpoint as well as FLEX\'s, so the tests inside the account can reach it.'
      sourceId 'apis'
      order '1'
      x '188'
      y '30'
      w '292'
      h '62'
      ownership 'uns'
      awsIcon 'apigateway'
    }
  }

  network_outside = platform 'HTTP Lambdas · outside the VPC' {
    #request-path
    description '11 routes and the authorizer'
    link https://github.com/govuk-once/gds-unified-notification-service/blob/main/infrastructure/cdk/constructs/UNSPSOResources.ts 'UNSPSOResources.ts'
    link https://github.com/govuk-once/gds-unified-notification-service/blob/main/infrastructure/cdk/constructs/UNSFlexResources.ts 'UNSFlexResources.ts'
    metadata {
      type 'AWS::Lambda::Function · no VpcConfig'
      tech 'Checkov CKV_AWS_117 suppressed: "not all lambdas need to be in VPCs by design"'
      role 'Every route handler except <code>postGroupMessage</code>, and the analytics export. They reach DynamoDB, SQS, SSM and Secrets Manager over the public AWS endpoints.'
      sourceId 'outside'
      order '2'
      x '580'
      y '30'
      w '292'
      h '62'
      ownership 'uns'
      awsIcon 'lambda'
    }
  }

  network_vpc = boundary 'VPC 10.0.0.0/16 · uns-{env}-main-vpc' {
    link https://github.com/govuk-once/gds-unified-notification-service/blob/main/infrastructure/cdk/constructs/bases/UNSVpcConstruct.ts 'UNSVpcConstruct.ts'
    link https://github.com/govuk-once/gds-unified-notification-service/blob/main/infrastructure/cdk/config.ts 'config.ts'
    metadata {
      type 'AWS::EC2::VPC'
      tech 'Amazon VPC · 65,536 addresses · 3 AZs'
      role 'Two tiers of /23 subnets across three availability zones, a NAT gateway in each, and no isolated tier.'
      facts [
        'A developer sandbox imports development\'s VPC from <code>/shared/vpc</code> instead of creating one.',
        'Flow logs to an S3 bucket in staging and production only; development has none.',
        'The CIDR and the zones come from the deploy environment — <code>cidr</code> and <code>availability_zones</code> — with 10.0.0.0/16 and a, b, c as the defaults; nothing in the repository overrides them.'
      ]
      sourceId 'vpc'
      order '0'
      x '40'
      y '150'
      w '1470'
      h '390'
      boundary 'hard'
    }

    network_private = boundary 'private with egress · 3 subnets' {
      metadata {
        type 'Subnet tier'
        tech 'PRIVATE_WITH_EGRESS · /23'
        role 'The pipeline functions and the cache. A route to the NAT in each zone.'
        sourceId 'private'
        order '0'
        x '164'
        y '200'
        w '340'
        h '134'
        boundary 'soft'
      }

      network_lambdas = platform 'Pipeline Lambdas · 5' {
        #request-path
        description 'the SQS handlers, in the VPC'
        link https://github.com/govuk-once/gds-unified-notification-service/blob/main/infrastructure/cdk/constructs/UNSPSOResources.ts 'UNSPSOResources.ts'
        link https://github.com/govuk-once/gds-unified-notification-service/blob/main/infrastructure/cdk/constructs/bases/UNSLambdaConstruct.ts 'UNSLambdaConstruct.ts'
        metadata {
          type 'AWS::Lambda::Function · VpcConfig'
          tech 'privateEgress security group · all outbound'
          role 'In the VPC because they need the cache. OneSignal and UDP are reached through the NAT; AWS services through the endpoints.'
          sourceId 'lambdas'
          order '1'
          x '188'
          y '250'
          w '292'
          h '62'
          ownership 'uns'
          resources [ 'subnets' ]
          awsIcon 'lambda'
        }
      }
    }

    network_public = boundary 'public · 3 subnets' {
      metadata {
        type 'Subnet tier'
        tech 'PUBLIC · /23'
        role 'The NAT gateways and nothing else.'
        sourceId 'public'
        order '0'
        x '164'
        y '380'
        w '340'
        h '134'
        boundary 'soft'
      }

      network_nat = platform 'NAT gateways · 3' {
        #request-path
        description 'one per availability zone'
        link https://github.com/govuk-once/gds-unified-notification-service/blob/main/infrastructure/cdk/constructs/bases/UNSVpcConstruct.ts 'UNSVpcConstruct.ts'
        metadata {
          type 'AWS::EC2::NatGateway ×3'
          tech 'natGateways: zones.length'
          role 'How dispatch reaches OneSignal and processing reaches UDP\'s endpoint.'
          sourceId 'nat'
          order '1'
          x '188'
          y '430'
          w '292'
          h '62'
          ownership 'uns'
          resources [ 'nat' ]
          awsIcon 'vpc-nat'
        }
      }
    }

    network_endpoints = platform 'VPC endpoints · 13' {
      #request-path
      description '11 interface · 2 gateway'
      link https://github.com/govuk-once/gds-unified-notification-service/blob/main/infrastructure/cdk/constructs/UNSCommon.ts 'UNSCommon.ts'
      link https://github.com/govuk-once/gds-unified-notification-service/blob/main/infrastructure/cdk/constructs/bases/UNSVpcConstruct.ts 'UNSVpcConstruct.ts'
      metadata {
        type 'AWS::EC2::VPCEndpoint ×13'
        tech 'private DNS · privateEgress security group · open'
        role 'API Gateway, Lambda, SQS, KMS, SSM, Secrets Manager, CloudWatch Logs, Monitoring and Application Insights, X-Ray and Network Firewall as interfaces; DynamoDB and S3 as gateways.'
        facts [
          'Nothing in the code calls Network Firewall or Application Insights; their endpoints are provisioned anyway.'
        ]
        sourceId 'endpoints'
        order '2'
        x '580'
        y '250'
        w '292'
        h '62'
        ownership 'uns'
        resources [ 'endpoints' ]
        awsIcon 'vpc-endpoint'
      }
    }

    network_cache = platform 'ElastiCache · Valkey' {
      #request-path
      description 'port 6379 · TLS'
      link https://github.com/govuk-once/gds-unified-notification-service/blob/main/infrastructure/cdk/constructs/bases/UNSElasticacheConstruct.ts 'UNSElasticacheConstruct.ts'
      link https://github.com/govuk-once/gds-unified-notification-service/blob/main/infrastructure/cdk/constructs/bases/UNSVpcConstruct.ts 'UNSVpcConstruct.ts'
      metadata {
        type 'AWS::ElastiCache::ServerlessCache'
        tech 'in the private subnets'
        role 'Both security groups open 6379 to and from the VPC CIDR for it.'
        sourceId 'cache'
        order '3'
        x '920'
        y '250'
        w '240'
        h '62'
        ownership 'uns'
      }
    }

    network_internet = external 'Internet' {
      #request-path
      description 'OneSignal · UDP\'s endpoint'
      link https://github.com/govuk-once/gds-unified-notification-service/blob/main/src/common/services/adapters/notificationAdapterOneSignal.ts 'notificationAdapterOneSignal.ts'
      metadata {
        type 'Outside'
        tech 'via the internet gateway'
        role '<code>api.onesignal.com</code>, and whatever host UDP\'s secret names for its private API.'
        sourceId 'internet'
        order '4'
        x '580'
        y '430'
        w '292'
        h '62'
        ownership 'third'
      }
    }

    network_sgs = platform 'Security groups · 2' {
      #off-request-path
      description 'privateEgress · privateIsolated'
      link https://github.com/govuk-once/gds-unified-notification-service/blob/main/infrastructure/cdk/constructs/bases/UNSVpcConstruct.ts 'UNSVpcConstruct.ts'
      metadata {
        type 'AWS::EC2::SecurityGroup ×2'
        tech 'one allows all outbound; the other none'
        role 'Both open TCP 6379 to and from the VPC. Every function and endpoint uses <code>privateEgress</code>; <code>privateIsolated</code> is only exported for sandboxes to import.'
        sourceId 'sgs'
        order '5'
        x '1180'
        y '250'
        w '292'
        h '62'
        ownership 'uns'
        resources [ 'sgs' ]
        awsIcon 'vpc'
      }
    }

    network_nacl = platform 'Network ACL · private tier' {
      #off-request-path
      description 'deny 22 and 3389 · allow the rest'
      link https://github.com/govuk-once/gds-unified-notification-service/blob/main/infrastructure/cdk/constructs/bases/UNSVpcConstruct.ts 'UNSVpcConstruct.ts'
      metadata {
        type 'AWS::EC2::NetworkAcl'
        tech 'rules 100, 110, 200'
        role 'On the private subnets only.'
        sourceId 'nacl'
        order '6'
        x '1180'
        y '340'
        w '292'
        h '62'
        ownership 'uns'
        awsIcon 'vpc'
      }
    }
  }

  network_apis -> network_lambdas 'invoke' {
    metadata { protocol 'Lambda service invocation — the API does not enter the VPC' auth 'The API\'s invoke permission' carries 'Only for postGroupMessage; the other routes are outside' order '1' }
  }
  network_lambdas -> network_endpoints 'AWS services' {
    metadata { protocol 'HTTPS to an endpoint ENI, or a gateway route' auth 'Function role; the endpoint security group' carries 'Tables, queues, parameters, secrets, logs' order '2' }
  }
  network_nat -> network_internet 'egress' {
    metadata { protocol 'NAT to the internet gateway' auth '—' carries 'Pushes to OneSignal; user lookups to UDP' order '3' }
  }
}

views {
  view network {
    title 'Network'
    include network_apis, network_outside
    include network_vpc, network_vpc.**
  }
}
