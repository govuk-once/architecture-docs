  "send": {
    "name": "Send path",
    "order": 2,
    "group": "Architecture",
    "audience": "On-call, and anyone tracing a notification that did not arrive",
    "blurb": "A message from a department to a phone, hop by hop, and beside it the group form of the same thing. Both share the dispatch queue and everything after it; the group path never asks UDP, because a group is already a list of push ids.",
    "note": "Every queue adds a ten-second delivery delay, so the fastest single message spends twenty seconds in queues before OneSignal sees it. A fresh environment deploys with both adapters set to VOID and sends nothing until SSM says otherwise.",
    "dashMeans": "a read or write of state beside the path, not a hop the message takes",
    "tables": [
      {
        "name": "What each step publishes to analytics, and what a failure means",
