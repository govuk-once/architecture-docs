            "infrastructure/cdk/constructs/bases/UNSQueueConstruct.ts"
          ]
        ],
        "cols": ["Step", "On start", "On success", "On failure", "Then"],
        "rows": [
          [
            "postMessage",
            "—",
            "<code>VALIDATED_API_CALL</code>",
            "400 to the caller",
            "processing queue"
          ],
          [
            "sqs.validation (incoming queue)",
            "<code>VALIDATING</code>",
            "<code>VALIDATED</code>",
            "<code>VALIDATION_FAILED</code>",
            "processing queue"
          ],
          [
            "sqs.processing",
            "<code>PROCESSING</code>",
            "<code>PROCESSED</code>",
            "<code>PROCESSING_FAILED</code>; back to the queue, DLQ after three",
            "dispatch queue"
          ],
          [
            "sqs.groupProcessingWorker",
            "worker metrics",
            "<code>PROCESSED</code> per device",
            "back to the queue, DLQ after three",
            "dispatch queue"
          ],
          [
            "sqs.dispatch",
            "<code>DISPATCHING</code>",
            "<code>DISPATCHED</code>",
            "<code>DISPATCHING_FAILED</code>; the breaker counts it",
            "OneSignal"
