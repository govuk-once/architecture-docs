  "components": {
    "name": "Components",
    "order": 4,
    "group": "Architecture",
    "audience": "Engineers changing a handler — this is the code, not the infrastructure",
    "blurb": "Inside one HTTP Lambda: the four middleware groups every handler runs through, in order, and the services the handler is handed. Queue and schedule handlers have shorter chains, drawn as single boxes. C4 level 3.",
    "note": "Dependencies are resolved inside the handler on every invocation, so a cold start pays nothing for them and a warm one pays every time.",
    "dashMeans": "a hand-off inside the library, not a call the handler makes",
    "w": 1480,
    "h": 1100,
    "tables": [
      {
        "name": "How an error becomes a response",
        "code": [
          [
            "httpErrorHandlerMiddleware.ts",
            "src/common/middlewares/httpErrorHandlerMiddleware.ts"
          ],
          ["BaseError.ts", "src/common/models/Errors/BaseError.ts"],
          [
            "requestValidatorMiddleware.ts",
            "src/common/middlewares/requestValidatorMiddleware.ts"
          ],
          [
            "responseValidatorMiddleware.ts",
            "src/common/middlewares/responseValidatorMiddleware.ts"
          ]
        ],
        "cols": ["Error class", "Status", "Body"],
        "rows": [
          [
            "<code>BadRequestError</code> — request or authorizer schema failed",
            "400",
            "<code>{ Status, HttpError, Errors }</code>"
          ],
          ["<code>UnauthorisedError</code>", "401", "the same shape"],
          [
            "<code>NotFoundError</code> — no record, or another person's",
            "404",
            "the same shape"
          ],
          [
            "<code>ExpectationFailedError</code> — the response failed its own schema",
            "417",
            "the same shape"
          ],
          [
            "<code>TooManyRequestsError</code> — the provider rate limit",
            "429",
            "the same shape; in a queue handler, the record returns to the queue"
          ],
          [
            "<code>InternalServerError</code> · <code>SimulatedError</code>",
            "500",
            "the same shape"
          ],
          [
            "<code>BadGatewayError</code> — the provider answered badly",
            "502",
            "the same shape"
          ],
          [
            "Anything not a <code>BaseError</code>",
            "500",
            "<code>An unexpected error occurred</code>"
          ]
        ]
      }
    ]
