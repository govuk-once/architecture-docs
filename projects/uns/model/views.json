  "flex": {
    "name": "Read-back API",
    "order": 5,
    "group": "Architecture",
    "audience": "FLEX engineers, and anyone tracing what the app sees",
    "blurb": "What FLEX reads and changes on the app's behalf: a person's notifications, and the groups their device belongs to. Numbered from the caller down.",
    "note": "The person is a query-string id, the same push id UDP returned on the send path. A status change is an analytics event, not a write: what the app reads next depends on the analytics function having run.",
    "dashMeans": "a secret read out of band, not a request",
