            "code": [
              ["agui-agent-stack.ts", "cdk/src/stacks/agui-agent-stack.ts"],
              [
                "example-agent-stack.ts",
                "cdk/src/stacks/example-agent-stack.ts"
              ]
            ]
          }
        },
        {
